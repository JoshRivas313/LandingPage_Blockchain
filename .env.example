# Credenciales de la app de LinkedIn (https://www.linkedin.com/developers/apps).
# La app necesita los productos "Sign In with LinkedIn using OpenID Connect"
# y "Share on LinkedIn", y en Auth > Redirect URLs debe figurar exactamente:
#   https://TU-DOMINIO/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Clave para cifrar la cookie de sesion. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Opcional. Solo si el dominio publico no coincide con la cabecera Host
# (por ejemplo, para fijar el dominio de produccion y no el de un preview).
# LINKEDIN_REDIRECT_ORIGIN=https://blockchainconf.example
